#!/usr/bin/env bash
#
# Find and manage the review-plan hunk extension's plan file without
# reimplementing the path derivation that lives in the extension's own
# plan.ts (repoDigest / planCandidatePaths / viewedStatePath). Lets an agent
# (or the user) write, inspect, and clear a plan from outside hunk itself.
#
# Path resolution mirrors plan.ts exactly:
#   state-dir plan:  ${XDG_STATE_HOME:-$HOME/.local/state}/hunk/review-plan/<digest>.json
#   in-repo plan:    <repoRoot>/.hunk/review-plan.json
#   viewed state:    ${XDG_STATE_HOME:-$HOME/.local/state}/hunk/review-plan/<digest>.viewed.json
#   loop hand-off:   ${XDG_STATE_HOME:-$HOME/.local/state}/hunk/review-plan/<digest>.loop/ (go.ts)
#   notes journal:   ${XDG_STATE_HOME:-$HOME/.local/state}/hunk/review-plan/<digest>.notes.jsonl (journal.ts)
# <digest> is the first 16 hex chars of sha256(<absolute repo root path>),
# byte-identical to plan.ts's repoDigest() -- hashed with `printf %s`, not
# `echo`, so no trailing newline sneaks into the hashed bytes.
#
# hunk itself also honors an HUNK_REVIEW_PLAN env var that overrides both of
# the above; `show` checks it too (matching plan.ts's own candidate order)
# but `path`/`write` do not expose it as a flag -- this tool only manages the
# two on-disk locations hunk resolves by default.

set -euo pipefail

PROG=hunk-plan

usage() {
  cat <<'USAGE'
Usage: hunk-plan <command> [options]

Commands:
  path [--in-repo]     Print the plan path (state-dir path by default,
                        <repoRoot>/.hunk/review-plan.json with --in-repo).
  write [--in-repo]     Read a plan as JSON on stdin, validate it (version==1,
                        a "groups" array), and write it atomically to the
                        resolved path (default: state-dir path). Each write
                        stamps a fresh "planId" into the stored plan, which
                        ties review-loop hand-offs to it (see wait), and the
                        "head" commit and "branch" it was written on (see
                        list). Warns on
                        stderr, after writing, about a one-way group ranked
                        Skim, an unknown "door" value, a malformed
                        "blastRadius", and a "mergeDanger" that is malformed,
                        out of date with the groups, or has a disagreement
                        with no reason.
  show                  Print the resolved plan (checks HUNK_REVIEW_PLAN, then
                        the in-repo path, then the state-dir path -- same
                        order plan.ts uses) or exit 1 naming what was checked.
  sidecar [--in-repo] [-o <path>]
                        Read the resolved plan (same resolution as `show`;
                        --in-repo reads <repoRoot>/.hunk/review-plan.json
                        directly instead) and emit hunk's native
                        `--agent-context` sidecar JSON: file order plus each
                        file's plan annotations, tagged "source":
                        "review-plan". Written to stdout, or to -o <path>.
                        A group marked hidden is sunk to the end of the file
                        order (hunk's sidecar has no hide mechanism); a note
                        on stderr says how many files were sunk that way.
  report-dir [--in-repo] [--init]
                        Print the report directory (<plan>.report/) that holds
                        the agent-authored body content for `render`. With
                        --init, create it and scaffold an empty meta.json,
                        _overview.md, _tldr.md, _decisions.md, _glossary.md,
                        and a <group-slug>.why.md, .example.md and .md per
                        group in the plan -- so nothing has to derive a slug
                        by hand.
                        Existing files are never overwritten.
  render [--in-repo] [-o <path>]
                        Render the plan plus its report directory into a
                        self-contained HTML page at <plan>.html (or -o), and
                        copy the marked/mermaid assets alongside it. The frame,
                        nav, table of contents, section ids, verdict badges and
                        link rules are all derived here; only the body prose
                        comes from the report directory. A plan "mergeDanger"
                        leads the TL;DR. With bin/merge-danger allowed (see
                        danger), a review record for the current content
                        (review-record.json in the git dir) adds the items
                        held for you under the TL;DR and a closed block of
                        the settled ones. When the repo has a
                        bin/merge-danger, or a review record sits in its git
                        dir, the TL;DR also says whether a review record
                        covers this content. An empty _decisions.md renders
                        as one line saying that only the session where the
                        change was asked for can write it.
                        Sentences over 25 words and an oversized glossary are
                        reported on stderr; they never stop the render.
                        A meta.json "docs" entry takes either "path" (repo-
                        relative, absolute or ~-prefixed; converted according to
                        its extension) or "url" (an external nav link, never
                        fetched) -- one or the other, never both.
  clear [--yes]         Remove this repo's plan (both possible locations) and
                        its sibling .viewed.json, .sidecar.json, .html,
                        .report/, .loop/ and .notes.jsonl. Asks for
                        confirmation unless --yes.
  gc [--dry-run] [--yes] [--older-than <days>]
                        Sweep the whole state directory, not just this repo:
                        artifacts with no plan file, plans whose repo no longer
                        exists (resolved through repos.json), and plans older
                        than <days> (default 30). Shared assets go once the
                        last report does. A notes journal with no plan goes
                        only once it is older than <days> too, since notes
                        saved without a plan are still notes. Asks for
                        confirmation unless --yes.
  viewed                Print the viewed-state path.
  notes [--json] [--all]
                        Print the notes saved in Hunk for this repo, read from
                        the notes journal the review-plan extension writes the
                        moment each note is saved, so they outlive Hunk. The
                        current plan's notes by default; --all for every plan.
                        Per Hunk window, the newest snapshot of the review
                        stands and notes saved after it are added; a note that
                        snapshot no longer holds was deleted. Snapshots are
                        taken when one of the extension's keys (S, A, V, X, <,
                        >) runs, so an agent reply shows only once one has.
  list [--json] [--here]
                        One row per review plan in the state directory, newest
                        first: repo, branch, plan age, commits the branch moved
                        since the plan ("rebased" when the plan's commit is no
                        longer an ancestor), the Hunk window (open, closed, or
                        "earlier" when it still shows an earlier plan), a live
                        Hunk session, open/all user notes, viewed marks against
                        the plan's files, and sends to the agent (A: approved).
                        Viewed is a lower bound: a reviewer reads files without
                        marking them, and a mark left on a file that changed
                        since still counts. --here lists only this repo's plan,
                        found as show finds it. --json adds the plan's files,
                        the viewed ones, the notes sent, the last hand-off, the
                        door calls, the merge-danger verdict and the writeup;
                        a value nothing on disk records is null. Plans written
                        before "head" was stamped show "?" for it.
  danger [--in-repo] [--allowed]
                        Cross-check the plan's door calls against the repo's
                        merge-danger verdict, when the repo has an executable
                        bin/merge-danger (Vendis). That script comes with the
                        checked-out branch, so it runs only when the repo's
                        local git config allows its content (git config
                        --local --add hunk.mergeDanger <blob id>; a refusal
                        prints the id). Uses the stored verdict
                        when `bin/merge-danger --check` calls it current, and
                        a fresh floor (--floor --stdout --committed) when not.
                        Prints a "mergeDanger" object for the plan, with each
                        disagreement's "reason" left for the review to write.
                        A second opinion, never a gate: with no tool, or when
                        the tool fails, it says so on stderr and exits 0.
                        --allowed needs no plan and runs nothing: it prints
                        allowed, none (no bin/merge-danger) or refused, with
                        the refusal and the allow command on stderr.
  wait [--timeout <seconds>]
                        Block until the reviewer hands the review back from
                        Hunk ("Send review to agent", S) or approves it
                        (A), for at most <seconds> (default 480). Prints the
                        hand-off as JSON: kind, mode, instruction and every
                        note, the reviewer's new ones marked "new": true.
                        Without the extension, a note typed in Hunk that reads
                        GO (or "GO: <instruction>") or APPROVE does the same
                        through the session daemon, and is removed once read;
                        once the extension has opened the repo, typed notes
                        are not read. Only an answer to the current plan
                        counts: a hand-off from a window showing an earlier
                        plan, or from one started before plan ids, is set
                        aside as <loop>/stale.json (named on stderr) and the
                        wait goes on, and so does a quit of such a window.
                        Exit codes: 0 go, 10 approved, 2 still waiting (run it
                        again), 3 nothing to wait on (no plan and no Hunk
                        window, or Hunk was closed since the plan was written).
  -h, --help            Show this help.

Must be run inside a git repository; the repo root is resolved via
`git rev-parse --show-toplevel`.
USAGE
}

die() {
  echo "$PROG: $*" >&2
  exit 1
}

repo_root() {
  local root
  if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
    die "not inside a git repository"
  fi
  printf '%s' "$root"
}

# First 16 hex chars of sha256(<repo root>), matching plan.ts's repoDigest().
digest_for() {
  local root="$1" hash
  hash=$(printf '%s' "$root" | sha256sum) || die "sha256sum failed"
  printf '%s' "${hash:0:16}"
}

state_dir() {
  printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

# A new plan id: UTC time plus 32 random bits, unique per write.
new_plan_id() {
  printf '%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
}

# The id `write` stamped into a plan or a hand-off file; nothing for one from
# before plan ids, or for no file at all.
plan_id_of() {
  [[ -n ${1:-} && -f $1 ]] || return 0
  jq -r '.planId // empty | strings' "$1" 2>/dev/null || true
}

# A file's modification time in epoch seconds: GNU stat, then BSD stat.
mtime_of() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

state_plan_path() {
  local root="$1" d
  d=$(digest_for "$root")
  printf '%s/hunk/review-plan/%s.json' "$(state_dir)" "$d"
}

in_repo_plan_path() {
  printf '%s/.hunk/review-plan.json' "$1"
}

viewed_path_for() {
  local root="$1" d
  d=$(digest_for "$root")
  printf '%s/hunk/review-plan/%s.viewed.json' "$(state_dir)" "$d"
}

# The notes journal, matching journal.ts's journalPath().
journal_path_for() {
  local root="$1" d
  d=$(digest_for "$root")
  printf '%s/hunk/review-plan/%s.notes.jsonl' "$(state_dir)" "$d"
}

# The review loop's hand-off directory, matching go.ts's loopDir().
loop_dir_for() {
  local root="$1" d
  d=$(digest_for "$root")
  printf '%s/hunk/review-plan/%s.loop' "$(state_dir)" "$d"
}

has_flag() {
  local want="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ $arg == "$want" ]] && return 0
  done
  return 1
}

cmd_path() {
  local root target
  root=$(repo_root)
  if has_flag --in-repo "$@"; then
    target=$(in_repo_plan_path "$root")
  else
    target=$(state_plan_path "$root")
  fi
  printf '%s\n' "$target"
}

cmd_write() {
  local root target dir tmp
  root=$(repo_root)
  if has_flag --in-repo "$@"; then
    target=$(in_repo_plan_path "$root")
  else
    target=$(state_plan_path "$root")
  fi

  command -v jq >/dev/null 2>&1 || die "jq is required to validate the plan before writing"

  dir=$(dirname "$target")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.review-plan.XXXXXX")

  # Read stdin into the temp file first so a validation failure never
  # touches the real target.
  if ! cat >"$tmp"; then
    rm -f "$tmp"
    die "failed to read plan JSON from stdin"
  fi

  if ! jq -e '(.version == 1) and ((.groups | type) == "array")' "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    die "stdin is not a valid review plan (need JSON with \"version\": 1 and a \"groups\" array)"
  fi

  # A fresh id on every write, replacing any the input carried. Hand-offs from
  # Hunk carry the id of the plan their window showed, so `wait` can tell an
  # answer to this plan from one a still-open window sends for an earlier
  # review: the loop directory is keyed by repo, not by review. The commit and
  # branch the plan was written on are stamped the same way, so `list` can say
  # how far the branch moved since; an unborn HEAD or a detached one leaves
  # the field out rather than guessing.
  local stamped head branch
  head=$(git -C "$root" rev-parse -q --verify HEAD 2>/dev/null) || head=""
  branch=$(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null) || branch=""
  stamped=$(mktemp "$dir/.review-plan.XXXXXX")
  if ! jq --arg id "$(new_plan_id)" --arg head "$head" --arg branch "$branch" '
    .planId = $id
    | (if $head == "" then del(.head) else .head = $head end)
    | (if $branch == "" then del(.branch) else .branch = $branch end)
  ' "$tmp" >"$stamped"; then
    rm -f "$tmp" "$stamped"
    die "failed to stamp the plan id, head and branch"
  fi
  rm -f "$tmp"

  mv -f "$stamped" "$target"
  manifest_record "$root"
  echo "$PROG: wrote $target"

  local warning
  while IFS= read -r warning; do
    if [[ -n $warning ]]; then echo "$PROG: $warning" >&2; fi
  done < <(jq -r "$DOOR_WARNINGS_JQ" "$target" 2>/dev/null; jq -r "$DANGER_WARNINGS_JQ" "$target" 2>/dev/null)

  # Never delete as a side effect of a write -- just say when the drawer is
  # full. Removal stays an explicit `gc`.
  local sdir count
  sdir="$(state_dir)/hunk/review-plan"
  count=$(find "$sdir" -maxdepth 1 -name '*.json' ! -name 'repos.json' ! -name '*.viewed.json' ! -name '*.sidecar.json' 2>/dev/null | wc -l)
  if [[ ${count:-0} -gt 10 ]]; then
    echo "$PROG: $count review plans in $sdir -- 'hunk-plan gc --dry-run' shows what is collectable" >&2
  fi
}

cmd_show() {
  local root candidates=() c
  root=$(repo_root)

  if [[ -n ${HUNK_REVIEW_PLAN:-} ]]; then
    candidates+=("$HUNK_REVIEW_PLAN")
  fi
  candidates+=("$(in_repo_plan_path "$root")")
  candidates+=("$(state_plan_path "$root")")

  for c in "${candidates[@]}"; do
    if [[ -f $c ]]; then
      cat "$c"
      return 0
    fi
  done

  {
    echo "$PROG: no review plan found. Looked at:"
    printf '  %s\n' "${candidates[@]}"
  } >&2
  exit 1
}

# Emit hunk's native --agent-context sidecar JSON: { version, summary?, files }
# derived from the plan's own groups/files/annotations, in the order the
# extension applies them. This is a lossy one-way projection of the plan
# (importance/collapsed/hidden all vanish, hidden groups just sink to the
# bottom of the file order) -- the plan JSON stays the single authored
# source, this is only ever regenerated from it.
cmd_sidecar() {
  local root resolved out_path=""
  root=$(repo_root)

  command -v jq >/dev/null 2>&1 || die "jq is required to build the sidecar"

  if has_flag --in-repo "$@"; then
    resolved=$(in_repo_plan_path "$root")
    [[ -f $resolved ]] || die "no plan at $resolved (--in-repo)"
  else
    local candidates=() c
    if [[ -n ${HUNK_REVIEW_PLAN:-} ]]; then
      candidates+=("$HUNK_REVIEW_PLAN")
    fi
    candidates+=("$(in_repo_plan_path "$root")")
    candidates+=("$(state_plan_path "$root")")

    resolved=""
    for c in "${candidates[@]}"; do
      if [[ -f $c ]]; then
        resolved="$c"
        break
      fi
    done
    if [[ -z $resolved ]]; then
      {
        echo "$PROG: no review plan found. Looked at:"
        printf '  %s\n' "${candidates[@]}"
      } >&2
      exit 1
    fi
  fi

  local args=("$@") i
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == "-o" ]]; then
      out_path="${args[i + 1]:-}"
      [[ -n $out_path ]] || die "-o requires a path argument"
    fi
  done

  local sunk_count
  sunk_count=$(jq '[.groups[]? | select(.hidden == true) | (.files // []) | length] | add // 0' "$resolved") ||
    die "failed to inspect $resolved"

  local json
  json=$(jq -c '
    (.groups // []) as $groups
    | ($groups | map(select(.hidden != true))) as $visible
    | ($groups | map(select(.hidden == true))) as $hidden
    | (
        ($visible + $hidden)
        | map(
            . as $group
            | ($group.files // [])
            | map(
                . as $file
                | {path: $file.path}
                + (
                    if $group.title == "Unplanned" then
                      (if ($file.note // null) != null then {summary: $file.note} else {} end)
                    else
                      {summary: (if ($file.note // null) != null then ($group.title + " — " + $file.note) else $group.title end)}
                    end
                  )
                + {annotations: (($file.annotations // []) | map(. + {source: "review-plan"}))}
              )
          )
        | add // []
      ) as $files
    | {version: 1}
      + (if (.summary // null) != null then {summary: .summary} else {} end)
      + {files: $files}
  ' "$resolved") || die "failed to build sidecar JSON from $resolved"

  printf '%s' "$json" | jq -e . >/dev/null 2>&1 || die "internal error: sidecar JSON failed to validate"

  if [[ $sunk_count -gt 0 ]]; then
    echo "$PROG: sank $sunk_count file(s) from hidden group(s) to the end of the sidecar file order" >&2
  fi

  if [[ -n $out_path ]]; then
    printf '%s' "$json" | jq . >"$out_path"
    echo "$PROG: wrote $out_path"
  else
    printf '%s' "$json" | jq .
  fi
}

cmd_clear() {
  local root state_plan in_repo_plan viewed target existing=() reply
  root=$(repo_root)
  state_plan=$(state_plan_path "$root")
  in_repo_plan=$(in_repo_plan_path "$root")
  viewed=$(viewed_path_for "$root")

  # The whole family, not just the plan. Leaving the rendered .html and its
  # .report/ behind after a `clear` is how the state directory silently grew
  # artifacts nothing could account for.
  for target in \
    "$state_plan" "$in_repo_plan" "$viewed" \
    "$(html_path_for "$state_plan")" "$(sidecar_path_for "$state_plan")" \
    "$(report_dir_for "$state_plan")" "$(loop_dir_for "$root")" "$(journal_path_for "$root")" \
    "$(html_path_for "$in_repo_plan")" "$(report_dir_for "$in_repo_plan")"; do
    [[ -e $target ]] && existing+=("$target")
  done

  if [[ ${#existing[@]} -eq 0 ]]; then
    echo "$PROG: nothing to clear (checked $state_plan, $in_repo_plan, $viewed)"
    return 0
  fi

  if ! has_flag --yes "$@"; then
    echo "About to remove:"
    printf '  %s\n' "${existing[@]}"
    read -r -p "Proceed? [y/N] " reply || reply="n"
    [[ $reply =~ ^[Yy]$ ]] || die "aborted, nothing removed"
  fi

  for target in "${existing[@]}"; do
    rm -rf "$target" # -r: the report and loop directories are among these
    echo "$PROG: removed $target"
  done
}

cmd_viewed() {
  local root
  root=$(repo_root)
  printf '%s\n' "$(viewed_path_for "$root")"
}

# ── notes journal ────────────────────────────────────────────────────────────
#
# The review-plan extension appends to <digest>.notes.jsonl (journal.ts): a
# "created" line the moment a note is saved, and a "snapshot" line of the
# whole review whenever one of its commands runs and the notes changed. This
# reads it back, so notes outlive the Hunk window that held them.
#
# Per window, the newest snapshot stands and notes saved after it are added.
# A note missing from that snapshot was deleted; one saved and deleted with no
# snapshot in between stays, since Hunk reports no deletions. A line that does
# not parse -- a write cut short by a crash -- is skipped, never fatal.
NOTES_JQ='
  split("\n") | map(fromjson?)
  | map(select(type == "object" and .v == 1 and (.event == "created" or .event == "snapshot")))
  | to_entries | map(.value + {seq: .key})
  | (if $all then . else map(select((.planId // "") == $plan)) end)
  | group_by(.window // "")
  | map(
      sort_by(.seq) as $es
      | ([$es[] | select(.event == "snapshot")] | last) as $snap
      | (if $snap == null then -1 else $snap.seq end) as $cut
      | (if $snap == null then []
         else [$snap.notes[]? | . + {planId: $snap.planId, window: $snap.window, recordedAt: $snap.at}] end) as $base
      | ($base | map(.id)) as $ids
      | $base + [ $es[] | select(.event == "created" and .seq > $cut)
                  | .note + {planId, window, recordedAt: .at}
                  | select(.id as $id | $ids | any(. == $id) | not) ]
    )
  | add // []
  | sort_by([(.file // ""), (.line // 0), (.recordedAt // "")])
'

cmd_notes() {
  local root journal plan plan_id all=false notes count
  root=$(repo_root)
  has_flag --all "$@" && all=true
  command -v jq >/dev/null 2>&1 || die "jq is required to read the notes journal"
  journal=$(journal_path_for "$root")
  plan=$(resolve_plan "$root" 2>/dev/null) || plan=""
  plan_id=$(plan_id_of "$plan")

  if [[ -f $journal ]]; then
    notes=$(jq -R -s --arg plan "$plan_id" --argjson all "$all" "$NOTES_JQ" "$journal")
  else
    notes='[]'
  fi
  count=$(printf '%s' "$notes" | jq 'length')

  if has_flag --json "$@"; then
    jq -n --arg journal "$journal" --arg plan "$plan_id" --argjson all "$all" --argjson notes "$notes" \
      '{journal: $journal, planId: (if $all or $plan == "" then null else $plan end), notes: $notes}'
    return 0
  fi

  if [[ $count -eq 0 ]]; then
    if [[ -f $journal ]]; then
      local scope="for this plan"
      $all && scope="for $root"
      echo "$PROG: no notes recorded $scope ($journal)" >&2
    else
      echo "$PROG: no notes journal for $root yet ($journal)" >&2
    fi
    return 0
  fi

  echo "$count note$([[ $count -eq 1 ]] || echo s) from $journal"
  printf '%s' "$notes" | jq -r '.[] |
    "",
    "\(.file // "(file unknown)"):\(.line // "?")\(if .side then " (" + .side + ")" else "" end)  [\(.source // "user")\(if .parentId then ", reply to " + .parentId else "" end)\(if .resolution and .resolution != "active" then ", " + .resolution else "" end)]",
    ((.summary // "") | split("\n") | map("  " + .) | join("\n")),
    (if .rationale then ((.rationale | split("\n") | map("  " + .) | join("\n"))) else empty end)'
}

# ── review list ──────────────────────────────────────────────────────────────
#
# `list` says which reviews exist and how far each got, from the state
# directory alone: one row per plan. A row reads only what the extension and
# this script already keep (the plan, its viewed marks, the loop directory and
# the notes journal) plus git in the repo the manifest names. A review whose
# worktree is gone still lists; what only git could say is null.

# A plan's journal, summed up for its row: user notes, agent replies, the user
# notes still open, and what reached the agent. A user note is open while it
# is active and unanswered. hunk-handle-notes answers with `comment add` at the
# note's file and line, which sets no parentId, so an agent note answers it
# when it names it as parent or sits on the same file, side and line and is no
# older. Sends are this plan's "sendToAgent" snapshots; the notes sent are the
# distinct user notes they held.
LIST_JOURNAL_JQ='. as $raw
  | ($raw | '"$NOTES_JQ"') as $notes
  | ($raw | split("\n") | map(fromjson?)
     | map(select(type == "object" and .v == 1 and .event == "snapshot"
                  and (.planId // "") == $plan))) as $snaps
  | [$notes[] | select(.source == "agent")] as $agent
  | [$notes[] | select((.source // "user") == "user")] as $user
  | [$snaps[] | select(.trigger == "sendToAgent")] as $sends
  | def answered: . as $n | (.createdAt // .recordedAt // "") as $at
      | any($agent[]; .parentId == $n.id
          or (.file == $n.file and .side == $n.side and .line == $n.line
              and ((.createdAt // .recordedAt // "") >= $at)));
    {
      user: ($user | length),
      agent: ($agent | length),
      open: ([$user[] | select((.resolution // "active") == "active") | select(answered | not)] | length),
      sends: ($sends | length),
      notesSent: ([$sends[] | .notes[]? | select((.source // "user") == "user") | .id] | unique | length),
      approved: any($snaps[]; .trigger == "approveReview")
    }'

# One row. Every input is a file read here or a value git gave; jq only
# assembles them, so a missing or unreadable file is null in the row, never an
# error. Only the plan itself must parse. The journal is summed up in the same
# call, with the $plan and $all that NOTES_JQ reads bound to this plan.
LIST_ROW_JQ='
  def nn: if . == "" then null else . end;
  def doc: if . == "" then null else (fromjson? // null) end;
  def door_ok: .door == "one-way" or .door == "two-way";
  $planId as $plan | false as $all
  | ($planDoc[0]) as $p
  | [$p.groups[]? | select(type == "object")] as $groups
  | ([$groups[] | .files[]? | select(type == "object") | .path | strings] | unique) as $files
  | ($viewedRaw | doc | .entries? // {} | if type == "object" then . else {} end) as $marks
  | ($lastRaw | doc | if type == "object" and (.kind | type) == "string" then . else null end) as $hand
  | (if $journalRaw == "" then null else ($journalRaw | '"$LIST_JOURNAL_JQ"') end) as $journal
  | {
      key: $key,
      repo: ($root | nn),
      repoExists: $exists,
      branch: (($branch | nn) // ($p.branch | strings | nn) // null),
      plan: $planPath,
      planId: ($planId | nn),
      writtenAt: (
        ($planId | capture("^(?<y>[0-9]{4})(?<m>[0-9]{2})(?<d>[0-9]{2})T(?<H>[0-9]{2})(?<M>[0-9]{2})(?<S>[0-9]{2})Z")?
         | "\(.y)-\(.m)-\(.d)T\(.H):\(.M):\(.S)Z")
        // (if $mtime == "" then null else ($mtime | tonumber | todate) end)),
      head: {plan: (($p.head | strings | nn) // null), now: ($now | nn), moved: $moved, rebased: $rebased},
      window: (if $winState == "" then null
               else {state: $winState, planId: ($winId | nn), showsPlan: $winShows} end),
      session: (if $sessions == null or $root == "" then null
                else any($sessions[]; . == $root) end),
      notes: $journal,
      lastHandoff: (if $hand == null then null else {
        kind: $hand.kind, mode: ($hand.mode // null), createdAt: ($hand.createdAt // null),
        notes: ([$hand.notes[]?] | length),
        forPlan: (if $planId == "" then null else ($hand.planId // "") == $planId end)
      } end),
      viewed: {marked: ([$files[] | select($marks[.] != null)] | length), of: ($files | length)},
      planFiles: $files,
      viewedFiles: ($marks | keys),
      groups: ($groups | length),
      doors: ([$groups[] | select(door_ok)] | length),
      oneWay: ([$groups[] | select(.door == "one-way")] | length),
      mergeDanger: (if ($p.mergeDanger | type) == "object" then {
        door: ($p.mergeDanger.door // null), depth: ($p.mergeDanger.depth // null),
        disagreements: ([$p.mergeDanger.disagreements[]?] | length)
      } else null end),
      writeup: {html: ($html | nn), overview: $overview, glossary: $glossary}
    }
'

# The text table, one line per row. Every field is non-empty: `read` with
# IFS=$'\t' collapses a run of tabs, so an empty field would shift the rest.
LIST_TEXT_JQ='
  def ago: if . == null then "?" else (now - fromdate) as $s
    | if $s < 3600 then "\($s / 60 | floor)m"
      elif $s < 172800 then "\($s / 3600 | floor)h"
      else "\($s / 86400 | floor)d" end end;
  .[] | select(.error | not)
  | [ (.writtenAt | ago),
      (if .repo == null then "? " + .key
       elif .repoExists then .repo | split("/") | last
       else (.repo | split("/") | last | .[0:25]) + " (gone)" end),
      (.branch // "-"),
      (if .head.rebased == true then "rebased"
       elif .head.moved != null then "+\(.head.moved)" else "?" end),
      (if .window == null then "-"
       elif .window.state == "open" and .window.showsPlan == false then "earlier"
       else .window.state end),
      (if .session == true then "yes" elif .session == false then "no" else "?" end),
      (if .notes == null then "-" else "\(.notes.open)/\(.notes.user)" end),
      "\(.viewed.marked)/\(.viewed.of)",
      ( ([(.notes.sends // 0),
          (if .lastHandoff != null and .lastHandoff.kind == "go" and .lastHandoff.forPlan != false then 1 else 0 end)]
         | max | tostring)
        + (if .notes.approved == true
              or (.lastHandoff.kind == "approve" and .lastHandoff.forPlan != false)
           then " A" else "" end) ) ]
  | @tsv
'

# list_row <plan> <key> <root> <live session roots as JSON, or null>: one
# review as JSON. <root> is empty when the manifest does not know the plan's
# repo. Status 1: the plan does not parse. Two jq calls per row: a list over
# dozens of plans would otherwise spend its time starting processes.
list_row() {
  local plan="$1" key="$2" root="$3" sessions="$4" sdir loop meta plan_id head closed pid wid
  local exists=false now="" branch="" moved=null rebased=null state="" shows=true mtime="" html report rc
  local viewed=/dev/null last=/dev/null journal=/dev/null overview=false glossary=false win=/dev/null
  sdir="$(state_dir)/hunk/review-plan"
  loop="$sdir/$key.loop"
  [[ -f $loop/window.json ]] && win="$loop/window.json"

  # The plan's id and head, and the window's, in one read. `|` separates the
  # fields: unlike a tab it never collapses, so an empty one stays in place.
  meta=$(jq -rn '[inputs] as [$p, $w]
    | [ (($p.planId | strings) // ""), (($p.head | strings) // ""),
        (($w.closedAt // "") | tostring), (($w.pid // "") | tostring), (($w.planId | strings) // "") ]
    | join("|")' "$plan" "$win" 2>/dev/null) || return 1
  IFS='|' read -r plan_id head closed pid wid <<<"$meta"
  [[ -n $plan_id ]] || mtime=$(mtime_of "$plan") || mtime=""

  if [[ -n $root && -e $root/.git ]]; then
    exists=true
    branch=$(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null) || branch=""
    now=$(git -C "$root" rev-parse -q --verify HEAD 2>/dev/null) || now=""
    if [[ -n $head && -n $now ]]; then
      # 0: the plan's commit is an ancestor; 1: it is not; anything else: git
      # no longer has it. Either of the last two means the branch was rewritten.
      rc=0
      git -C "$root" merge-base --is-ancestor "$head" "$now" 2>/dev/null || rc=$?
      if [[ $rc -eq 0 || $rc -eq 1 ]]; then
        moved=$(git -C "$root" rev-list --count "$head..$now" 2>/dev/null) || moved=null
      fi
      if [[ $rc -eq 0 ]]; then rebased=false; else rebased=true; fi
    fi
  fi

  # The window as window_closed reads it: closed once it says so, or once its
  # process is gone. Whether it shows this plan follows for_earlier_plan: the
  # ids decide once the plan has one, file times before that.
  if [[ $win != /dev/null ]]; then
    state=open
    if [[ -n $closed ]] || { [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; }; then
      state=closed
    fi
    if [[ -n $plan_id ]]; then
      [[ $wid == "$plan_id" ]] || shows=false
    elif [[ $plan -nt $win ]]; then
      shows=false
    fi
  fi

  [[ -f $sdir/$key.notes.jsonl ]] && journal="$sdir/$key.notes.jsonl"
  [[ -f $sdir/$key.viewed.json ]] && viewed="$sdir/$key.viewed.json"
  [[ -f $loop/last.json ]] && last="$loop/last.json"
  html=$(html_path_for "$plan")
  [[ -f $html ]] || html=""
  report=$(report_dir_for "$plan")
  [[ -s $report/_overview.md ]] && overview=true
  [[ -s $report/_glossary.md ]] && glossary=true

  jq -cn --slurpfile planDoc "$plan" \
    --rawfile viewedRaw "$viewed" --rawfile lastRaw "$last" --rawfile journalRaw "$journal" \
    --arg key "$key" --arg root "$root" --argjson exists "$exists" --arg branch "$branch" \
    --arg planPath "$plan" --arg planId "$plan_id" --arg mtime "$mtime" --arg now "$now" \
    --argjson moved "$moved" --argjson rebased "$rebased" \
    --arg winState "$state" --arg winId "$wid" --argjson winShows "$shows" \
    --argjson sessions "$sessions" --arg html "$html" \
    --argjson overview "$overview" --argjson glossary "$glossary" "$LIST_ROW_JQ"
}

cmd_list() {
  local sdir mf root="" plan key r sessions=null rows="" row here=false
  command -v jq >/dev/null 2>&1 || die "jq is required to list reviews"
  sdir="$(state_dir)/hunk/review-plan"
  mf=$(manifest_path)
  local -a plans=() keys=() roots=()

  if has_flag --here "$@"; then
    here=true
    root=$(repo_root)
    plan=$(resolve_plan "$root" 2>/dev/null) || plan=""
    if [[ -n $plan ]]; then
      plans+=("$plan")
      keys+=("$(digest_for "$root")")
      roots+=("$root")
    fi
  else
    # The manifest, read once as "<key>|<root>" lines and looked up in bash.
    local manifest="" nl=$'\n' rest
    [[ -f $mf ]] && manifest=$(jq -r 'to_entries[] | select(.value | type == "string")
      | "\(.key)|\(.value)"' "$mf" 2>/dev/null) || manifest=""
    manifest="$nl$manifest$nl"
    for plan in "$sdir"/*.json; do
      [[ -f $plan ]] || continue
      key=$(basename "$plan" .json)
      [[ $key =~ ^[0-9a-f]{16}$ ]] || continue
      rest=${manifest#*"$nl$key|"}
      if [[ $rest != "$manifest" ]]; then r=${rest%%"$nl"*}; else r=""; fi
      plans+=("$plan")
      keys+=("$key")
      roots+=("$r")
    done
  fi

  # One call for every row, kept to the repo roots: a session also lists its
  # files, which every row would otherwise parse again. Without hunk, or when
  # the daemon does not answer, "live session" stays unknown rather than "no".
  if [[ ${#plans[@]} -gt 0 ]] && command -v hunk >/dev/null 2>&1; then
    sessions=$(hunk session list --json 2>/dev/null |
      jq -c 'if (.sessions | type) == "array" then [.sessions[] | .repoRoot | strings] else null end' \
        2>/dev/null) || sessions=null
    [[ -n $sessions ]] || sessions=null
  fi

  local i
  for ((i = 0; i < ${#plans[@]}; i++)); do
    if ! row=$(list_row "${plans[i]}" "${keys[i]}" "${roots[i]}" "$sessions") || [[ -z $row ]]; then
      row=$(jq -cn --arg k "${keys[i]}" --arg p "${plans[i]}" --arg r "${roots[i]}" \
        '{key: $k, repo: (if $r == "" then null else $r end), plan: $p, error: "unreadable plan"}')
    fi
    rows+="$row"$'\n'
  done
  rows=$(printf '%s' "$rows" | jq -s -c 'sort_by(.writtenAt // "") | reverse')

  if has_flag --json "$@"; then
    jq -n --arg dir "$sdir" --argjson reviews "$rows" '{stateDir: $dir, reviews: $reviews}'
    return 0
  fi

  if [[ $rows == "[]" ]]; then
    if $here; then
      echo "$PROG: no review plan for $root" >&2
    else
      echo "$PROG: no review plans in $sdir" >&2
    fi
    return 0
  fi

  local age repo branch head window live notes viewed sends
  printf '%-4s  %-32s  %-26s  %-7s  %-7s  %-4s  %-5s  %-7s  %s\n' \
    AGE REPO BRANCH HEAD WINDOW LIVE NOTES VIEWED SENDS
  while IFS=$'\t' read -r age repo branch head window live notes viewed sends; do
    printf '%-4s  %-32.32s  %-26.26s  %-7s  %-7s  %-4s  %-5s  %-7s  %s\n' \
      "$age" "$repo" "$branch" "$head" "$window" "$live" "$notes" "$viewed" "$sends"
  done < <(printf '%s' "$rows" | jq -r "$LIST_TEXT_JQ")
  printf '%s' "$rows" | jq -r '.[] | select(.error) | "\(.plan): \(.error)"' | while IFS= read -r row; do
    echo "$PROG: $row" >&2
  done
}

# ── report rendering ─────────────────────────────────────────────────────────

# Resolve this script's own checkout so assets/ is reachable through the symlink
# install.sh drops on PATH.
assets_dir() {
  local self dir
  self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null) || self="${BASH_SOURCE[0]}"
  dir=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd) ||
    die "cannot resolve the hunk-plan checkout from $self"
  [[ -d "$dir/assets" ]] ||
    die "no assets/ next to the hunk-plan checkout (looked in $dir). Is hunk-plan a copy rather than the symlink install.sh creates?"
  printf '%s/assets' "$dir"
}

report_dir_for() { printf '%s.report' "${1%.json}"; }
html_path_for() { printf '%s.html' "${1%.json}"; }
sidecar_path_for() { printf '%s.sidecar.json' "${1%.json}"; }
manifest_path() { printf '%s/hunk/review-plan/repos.json' "$(state_dir)"; }

# GNU base64 wraps at 76 columns and needs -w0 to stop; BSD/macOS base64 has no
# -w at all and spells decode -D. Strip newlines on the way out and try both
# decode spellings on the way in, so neither platform needs a special case.
b64e() { base64 <"$1" | tr -d '\n'; }
b64d() { printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D; }

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}
esc() { printf '%s' "$1" | html_escape; }

# Must stay byte-identical to the jq slug rule (slug_of in GROUP_JQ_DEFS below).
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# A design doc is not always inside the repo under review -- a sibling docs
# checkout, a shared vault, a path outside any repo at all. Absolute and
# ~-prefixed paths are taken as written; anything else stays repo-relative,
# which is what every path has always been.
resolve_doc_path() {
  local root="$1" p="$2"
  # The tildes below are deliberately literal: this expands a `~` a human wrote
  # into a meta.json string, where the shell never had a chance to.
  # shellcheck disable=SC2088
  case "$p" in
    '~') printf '%s' "$HOME" ;;
    '~/'*) printf '%s/%s' "$HOME" "${p#'~/'}" ;;
    /*) printf '%s' "$p" ;;
    *) printf '%s/%s' "$root" "$p" ;;
  esac
}

# How report.js should turn this file into a pane. The extension is the only
# thing the renderer knows about a file it never parses, so the decision is made
# here and travels as a data-format attribute rather than being re-guessed in JS.
doc_format() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.md | *.markdown | *.mdown | *.mkd) printf 'md' ;;
    *.html | *.htm) printf 'html' ;;
    *) printf 'text' ;;
  esac
}

# owner/repo, or empty when origin is not a github.com remote. A wrong guess is
# worse than no link, so anything unrecognized yields nothing.
github_slug() {
  local url slug
  url=$(git remote get-url origin 2>/dev/null) || return 0
  case "$url" in
    git@github.com:*) slug="${url#git@github.com:}" ;;
    ssh://git@github.com/*) slug="${url#ssh://git@github.com/}" ;;
    https://github.com/*) slug="${url#https://github.com/}" ;;
    http://github.com/*) slug="${url#http://github.com/}" ;;
    *) return 0 ;;
  esac
  slug="${slug%.git}"
  slug="${slug%/}"
  [[ $slug == */* ]] || return 0
  printf '%s' "$slug"
}

# Record digest -> repo root. The digest is a one-way hash of the repo path, so
# without this nothing can tell whether a state file's repo still exists -- which
# is exactly why orphaned .viewed.json files pile up with no way to sweep them.
manifest_record() {
  local root="$1" digest mf tmp
  command -v jq >/dev/null 2>&1 || return 0
  digest=$(digest_for "$root")
  mf=$(manifest_path)
  mkdir -p "$(dirname "$mf")"
  [[ -f $mf ]] || printf '{}\n' >"$mf"
  tmp=$(mktemp "$(dirname "$mf")/.repos.XXXXXX")
  if jq --arg d "$digest" --arg r "$root" '. + {($d): $r}' "$mf" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$mf"
  else
    rm -f "$tmp" # a corrupt manifest must never fail a plan write
  fi
}

# Same candidate order as `show`.
resolve_plan() {
  local root="$1"
  shift
  local candidates=() c
  if has_flag --in-repo "$@"; then
    c=$(in_repo_plan_path "$root")
    [[ -f $c ]] || die "no plan at $c (--in-repo)"
    printf '%s' "$c"
    return 0
  fi
  [[ -n ${HUNK_REVIEW_PLAN:-} ]] && candidates+=("$HUNK_REVIEW_PLAN")
  candidates+=("$(in_repo_plan_path "$root")" "$(state_plan_path "$root")")
  for c in "${candidates[@]}"; do
    if [[ -f $c ]]; then
      printf '%s' "$c"
      return 0
    fi
  done
  {
    echo "$PROG: no review plan found. Looked at:"
    printf '  %s\n' "${candidates[@]}"
  } >&2
  exit 1
}

# How a group's fields read, shared by `render` and `write`'s checks so a badge
# and a warning can never disagree. Each mirrors the review-plan extension's
# plan.ts: absent importance defaults to 50 and values clamp to 0..100; a door
# is "one-way" or "two-way"; a blast radius is a one-word scope plus a
# non-empty note. Anything else reads as null, as plan.ts drops it.
GROUP_JQ_DEFS='
  def importance_of:
    if (.importance | type) == "number"
    then (.importance | if . < 0 then 0 elif . > 100 then 100 else . end)
    else 50 end;
  def tier_of: if . <= 2 then "critical" elif . <= 5 then "review" else "skim" end;
  def slug_of: ascii_downcase | gsub("[^a-z0-9]+"; "-") | gsub("^-+"; "") | gsub("-+$"; "");
  def door_of: if .door == "one-way" or .door == "two-way" then .door else null end;
  def blast_of:
    .blastRadius as $b
    | if ($b | type) == "object"
         and ($b.scope | type) == "string" and ($b.scope | length > 0)
         and ($b.scope | test("\\s") | not)
         and ($b.note | type) == "string" and ($b.note | test("\\S"))
      then {scope: $b.scope, note: $b.note} else null end;
'

# One group per line: slug, badge tier, collapsed flag, door ("-" for none),
# then base64 title, blast scope, blast note ("-" for none) and summary (they
# carry arbitrary text; base64 keeps @tsv honest). Only the last field may be
# empty: `read` with IFS=$'\t' collapses a run of tabs, so an empty middle field
# would shift every field after it.
#
# Ordering and importance mirror plan.ts exactly -- groups sort by [hidden,
# importance, declaration order]. The HTML and the TUI must not be able to
# disagree about which group leads.
GROUPS_JQ="$GROUP_JQ_DEFS"'
  [ .groups[]? | {
      title: .title,
      summary: (.summary // ""),
      imp: importance_of,
      door: door_of,
      blast: blast_of,
      hidden: (.hidden == true),
      collapsed: (.collapsed == true)
    } ]
  | to_entries | map(.value + {order: .key})
  | sort_by([ (if .hidden then 1 else 0 end), .imp, .order ])
  | .[]
  | . as $g
  | ($g.title | slug_of) as $slug
  | ($g.imp | tier_of) as $tier
  | [ $slug, $tier,
      (if ($g.collapsed or $tier == "skim") then "1" else "0" end),
      ($g.door // "-"),
      ($g.title | @base64),
      (if $g.blast then ($g.blast.scope | @base64) else "-" end),
      (if $g.blast then ($g.blast.note | @base64) else "-" end),
      ($g.summary | @base64) ]
  | @tsv
'

# Advice on what a plan says about each group's door, one line per finding.
# Warnings only: the plan is already written when they print. A one-way group
# at Skim starts collapsed in the writeup, which is the wrong default for a
# change a revert cannot undo; an unknown door or a malformed blast radius would
# drop its badge, and with it this very check, without a word.
DOOR_WARNINGS_JQ="$GROUP_JQ_DEFS"'
  .groups[]? | select(type == "object")
  | (.title // "" | tostring) as $t
  | ( if has("door") and door_of == null
      then "group \"\($t)\" has door \(.door | tojson); use \"one-way\" or \"two-way\""
      else empty end ),
    ( if has("blastRadius") and blast_of == null
      then "group \"\($t)\" has a malformed blastRadius; use {\"scope\": \"<one word>\", \"note\": \"<one sentence>\"}"
      else empty end ),
    ( if door_of == "one-way" and (importance_of | tier_of) == "skim"
      then "group \"\($t)\" is one-way but ranked Skim (importance \(importance_of)); rank it 5 or lower, or say in the writeup why a skim is enough"
      else empty end )
'

# ── merge danger ─────────────────────────────────────────────────────────────
#
# A second opinion, never a gate. Vendis keeps a merge-danger verdict for the
# change, and its bin/merge-danger owns it: `danger` calls that tool and never
# recomputes what it computes (two of its detectors read file contents, so its
# class globs are not ours to re-apply). The review makes its door calls first,
# from the diff alone; `danger` then sets them next to the verdict. Every way
# the cross-check itself can fail ends the same: a note on stderr, exit 0, and
# a review without it.

# Shared by `danger`, `write` and `render`: door and depth ranks, and what the
# review says for the whole change. The door is one-way if any group is, the
# depth is the top group tier, and either is null where the plan made no call.
DANGER_JQ_DEFS="$GROUP_JQ_DEFS"'
  def ranks($f): if $f == "door" then ["two-way", "one-way"] else ["skim", "review", "critical"] end;
  def rank_of($f; $x): if ($x | type) == "string" then ranks($f) | index($x) else null end;
  def below($f; $a; $b): rank_of($f; $a) < rank_of($f; $b);
  def ranked_groups:
    [ (.groups // [])[] | select(type == "object") ]
    | to_entries
    | map(.value + {order: .key, imp: (.value | importance_of)}
          | . + {tier: (.imp | tier_of), call: door_of})
    | sort_by([ (if .hidden == true then 1 else 0 end), .imp, .order ]);
  def review_calls:
    ranked_groups as $g
    | { door: (if any($g[]; .call == "one-way") then "one-way"
               elif any($g[]; .call == "two-way") then "two-way" else null end),
        depth: ($g[0].tier // null) };
  def valid_row:
    type == "object" and (.field == "door" or .field == "depth")
    and rank_of(.field; .verdict) != null and rank_of(.field; .review) != null;
'

# The verdict on stdin, the plan in $plan: a mergeDanger object for the plan,
# reasons left blank for the review to write. Two kinds of disagreement:
#   - whole change: the verdict door or depth against the review calls. The
#     group is the one that sets a higher review call, and null otherwise.
#   - class: a group holding a fired class file but ranked below that class
#     depth, or called two-way where the class is one-way. A file outside the
#     plan counts as Skim with no door call.
# A whole-change row that only restates the class rows (the verdict sits at the
# floor, and a class row at that value exists) is left out. A lower needs the
# operator; a raise needs only the reviewer to confirm it.
DANGER_JQ="$DANGER_JQ_DEFS"'
  . as $v
  | ($plan[0] | ranked_groups) as $groups
  | ($plan[0] | review_calls) as $review
  | { door: ([ $groups[] | select(.call == "one-way") ][0].title // null),
      depth: ($groups[0].title // null) } as $decider
  | [ ($v.floor.classes // [])[] as $c
      | [ ($c.files // [])[] as $f
          | {file: $f, g: ([ $groups[] | select(any(.files[]?; .path == $f)) ][0])} ]
      | group_by(.g.order // 1e9) | .[]
      | .[0].g as $g
      | map(.file) as $files
      | ( ($g.tier // "skim") as $t
          | select(below("depth"; $t; $c.depth))
          | {field: "depth", verdict: $c.depth, review: $t, group: ($g.title // null), class: $c.id, files: $files} ),
        ( select($c.door == "one-way" and $g.call == "two-way")
          | {field: "door", verdict: "one-way", review: "two-way", group: $g.title, class: $c.id, files: $files} )
    ] as $classRows
  | [ ("door", "depth") as $f
      | select($review[$f] != null and $review[$f] != $v[$f])
      | {field: $f, verdict: $v[$f], review: $review[$f],
         group: (if below($f; $v[$f]; $review[$f]) then $decider[$f] else null end), class: null}
      | select((.group == null and .verdict == $v.floor[$f]
                and any($classRows[]; .field == $f and .verdict == $v[$f])) | not)
    ] as $wholeRows
  | { source: $source, status: $status, digest: ($v.digest // null),
      door: $v.door, depth: $v.depth, finalized: ($v.finalized != null),
      blastRadius: ($v.blastRadius // null), oneWayReasons: ($v.oneWayReasons // []),
      review: $review,
      disagreements: [ ($wholeRows + $classRows)[]
        | . + {needs: (if below(.field; .review; .verdict) then "operator" else "review" end), reason: ""} ] }
'

# Advice on a plan mergeDanger, one line per finding; like the door warnings,
# printed after the plan is written. A stale review entry means the groups
# changed after `danger` ran, so its rows describe calls the plan no longer makes.
DANGER_WARNINGS_JQ="$DANGER_JQ_DEFS"'
  select(has("mergeDanger"))
  | review_calls as $now
  | [ .groups[]? | select(type == "object") | .title ] as $titles
  | .mergeDanger as $m
  | if ($m | type) != "object" or rank_of("door"; $m.door) == null or rank_of("depth"; $m.depth) == null
    then "mergeDanger is malformed; the writeup leaves it out. Use the object hunk-plan danger prints"
    else
      ( if ($m.review | type) == "object" and ($m.review.door != $now.door or $m.review.depth != $now.depth)
        then "mergeDanger was made for other group calls; run hunk-plan danger again and copy the reasons over"
        else empty end ),
      ( ($m.disagreements // []) | if type == "array" then to_entries[] else empty end
        | .key as $i | .value as $r
        | if ($r | valid_row | not)
          then "mergeDanger disagreement \($i + 1) is malformed; the writeup leaves it out"
          else
            ( ($r.field + (if $r.group then " (\($r.group))" else "" end)) as $what
              | ( if ($r.reason | type) != "string" or ($r.reason | test("\\S") | not)
                  then "mergeDanger disagreement on \($what) has no reason; say why this review differs"
                  else empty end ),
                ( if $r.group != null and ($titles | index([$r.group]) | not)
                  then "mergeDanger disagreement on \($what) names a group the plan does not have"
                  else empty end ) )
          end )
    end
'

# The plan mergeDanger as an HTML block for the top of the TL;DR, or nothing
# when it is absent or malformed. $stale is "1" when the content changed since
# the verdict was read. Each row says what settling it takes, from the values
# themselves: a lower needs the operator, a raise needs a confirming note.
DANGER_HTML_JQ="$DANGER_JQ_DEFS"'
  .mergeDanger as $m
  | [ .groups[]? | select(type == "object") | .title ] as $titles
  | select(($m | type) == "object" and rank_of("door"; $m.door) != null and rank_of("depth"; $m.depth) != null)
  | def shown: {"one-way": "One-way", "two-way": "Two-way", critical: "Critical", review: "Review", skim: "Skim"}[.];
    def link($t): if ($titles | index([$t])) then "<a href=\"#group-\($t | slug_of)\">\($t | @html)</a>" else ($t | @html) end;
    def row:
      . as $r
      | ( [ (if $r.group != null then link($r.group) elif $r.class != null then "files outside the plan" else empty end),
            (if ($r.class | type) == "string" then @html "class <code>\($r.class)</code>" else empty end) ]
          | join(", ") ) as $ctx
      | "<li><strong>\(if $r.field == "door" then "Door" else "Depth" end)</strong>: "
        + @html "the verdict says \($r.verdict | shown), this review says \($r.review | shown)"
        + (if $ctx != "" then " (\($ctx))" else "" end) + "."
        + (if ($r.reason | type) == "string" and ($r.reason | test("\\S")) then " " + ($r.reason | @html) else "" end)
        + (if below($r.field; $r.review; $r.verdict)
           then " <span class=\"badge needs-operator\">Operator lowering needed</span>"
           else " <span class=\"badge needs-note\">Confirm in a note to raise</span>" end)
        + "</li>";
    [ ($m.disagreements // []) | if type == "array" then .[] else empty end | select(valid_row) ] as $rows
  | ( if $m.source == "floor" then "fresh floor; " + (($m.status // "") | if test("\\S") then . else "no current verdict" end)
      elif $m.finalized == false then "current verdict, not finalized"
      else "current verdict" end
      + (if $stale == "1" then "; for earlier content" else "" end) ) as $src
  | "<div class=\"danger\">"
    + @html "<p class=\"danger-verdict\">Merge danger: <strong>\($m.door) / \($m.depth)</strong> <span class=\"danger-src\">(\($src))</span></p>"
    + ( $m.blastRadius
        | if type == "object" and (.scope | type) == "string" and (.note | type) == "string"
          then @html "<p class=\"blast-radius\">Blast radius: <strong>\(.scope)</strong> &mdash; \(.note)</p>"
          else "" end )
    + ( [ ($m.oneWayReasons // []) | if type == "array" then .[] | strings else empty end ]
        | if $m.door == "one-way" and length > 0
          then "<p class=\"danger-reasons\">One-way because: " + (map(@html) | join("; ")) + "</p>"
          else "" end )
    + ( if ($rows | length) == 0
        then "<p class=\"danger-agree\">This review agrees with the verdict.</p>"
        else "<ul class=\"disagreements\">" + ($rows | map(row) | join("")) + "</ul>" end )
    + "</div>"
'

# What the review record (bin/merge-danger --record-review) settled. Items
# still held go under the TL;DR, because a person decides them; waived and
# rejected ones, and findings the gate accepted as known, go in a closed block.
# Fixed items never show: the review already closed them.
RECORD_JQ_DEFS='
  def where: [ (.file // empty | strings), (.line // empty | tostring) ] | join(":");
  def batch($d): [ .polish.batch? // [] | if type == "array" then .[] else empty end
                   | select(type == "object" and .disposition == $d) ];
'
RECORD_HELD_JQ="$RECORD_JQ_DEFS"'
  batch("held")
  | select(length > 0)
  | "<div class=\"held\"><h4>Held for you</h4><ul>"
    + (map(@html "<li><code>\(.rule // "")</code> <code>\(where)</code></li>") | join(""))
    + "</ul></div>"
'
RECORD_SETTLED_JQ="$RECORD_JQ_DEFS"'
  ((batch("waived") | map(. + {label: "Waived"})) + (batch("rejected") | map(. + {label: "Rejected"}))) as $b
  | [ .acceptedKnown? // [] | if type == "array" then .[] | strings else empty end ] as $k
  | (($b | length) + ($k | length)) as $n
  | select($n > 0)
  | "<details class=\"settled\"><summary>Settled by review (\($n))</summary><ul>"
    + ($b | map(@html "<li><strong>\(.label)</strong> <code>\(.rule // "")</code> <code>\(where)</code></li>") | join(""))
    + ($k | map(@html "<li><strong>Accepted as known</strong> \(.)</li>") | join(""))
    + "</ul></details>"
'

# bin/merge-danger comes with the checked-out branch, so running it because it
# is there would run whatever a branch under review put there. It runs only
# when its content is one the repo owner allowed in the repo's local git
# config, which no branch can change: hunk.mergeDanger holds the full blob id
# of each content allowed. A global or command-line setting does not count,
# nor does a value that names no content, such as true: that would allow
# whatever a later branch puts there. --no-filters hashes the bytes as they
# are, so no .gitattributes from the branch can change the id.
MERGE_DANGER_OID_RE='^([0-9a-f]{40}|[0-9a-f]{64})$'

# The blob ids the repo allows bin/merge-danger to have, oldest first.
merge_danger_allowed() {
  git -C "$1" config --local --get-all hunk.mergeDanger 2>/dev/null | grep -E "$MERGE_DANGER_OID_RE"
}

# The path of a bin/merge-danger allowed to run. Status 1: the repo has none.
# Status 2: it has one, but the repo allows no content of it. Status 3: the
# repo allows other content, not this one.
merge_danger_tool() {
  local root="$1" allowed oid
  [[ -x "$root/bin/merge-danger" ]] || return 1
  allowed=$(merge_danger_allowed "$root") || return 2
  oid=$(git -C "$root" hash-object --no-filters -- "$root/bin/merge-danger" 2>/dev/null) || return 3
  [[ -n $oid ]] && grep -qxF -- "$oid" <<<"$allowed" || return 3
  printf '%s' "$root/bin/merge-danger"
}

# Why merge_danger_tool refused with status $2 (2 or 3), with the commands
# that allow this content once you have read it.
merge_danger_refusal() {
  local root="$1" gate="$2" oid last allow
  oid=$(git -C "$root" hash-object --no-filters -- "$root/bin/merge-danger" 2>/dev/null) || oid=""
  allow="git config --local --add hunk.mergeDanger ${oid:-<blob id>}"
  if [[ $gate == 3 ]]; then
    last=$(merge_danger_allowed "$root" | tail -n 1) || last=""
    if [[ -n $last ]] && git -C "$root" cat-file -e "$last" 2>/dev/null; then
      printf '%s' "bin/merge-danger comes with the checked-out branch and changed since you allowed it for this repo; compare: git cat-file -p $last | diff -u - bin/merge-danger; then allow this content: $allow"
    else
      printf '%s' "bin/merge-danger comes with the checked-out branch and changed since you allowed it for this repo; read it, then allow this content: $allow"
    fi
  elif git -C "$root" config --local --get-all hunk.mergeDanger >/dev/null 2>&1; then
    printf '%s' "bin/merge-danger comes with the checked-out branch, so it runs only once you allow this content of it for this repo, and a hunk.mergeDanger that names no content, such as true, no longer counts; read it, then: $allow"
  else
    printf '%s' "bin/merge-danger comes with the checked-out branch, so it runs only once you allow this content of it for this repo; read it, then: $allow"
  fi
}

# The content digest bin/merge-danger keys its files by (the second field of
# --digest), or nothing when the tool fails. Pass --committed for HEAD tree,
# as `danger` reads a fresh floor.
merge_danger_digest() {
  local root="$1" tool="$2" out
  shift 2
  out=$(cd "$root" && "$tool" --digest "$@" 2>/dev/null) || return 0
  [[ $out == *' '* ]] && printf '%s' "${out#* }"
  return 0
}

cmd_danger() {
  local root plan tool gate=0 msg rc verdict="" source status err gitdir
  root=$(repo_root)
  # --allowed only says whether the gate lets bin/merge-danger run, so a review
  # can ask the user at its start, before it has a plan. It runs nothing.
  if has_flag --allowed "$@"; then
    merge_danger_tool "$root" >/dev/null || gate=$?
    case $gate in
      0) echo allowed ;;
      1) echo none ;;
      *)
        echo refused
        echo "$PROG: $(merge_danger_refusal "$root" "$gate")" >&2
        ;;
    esac
    return 0
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required for the merge-danger cross-check"
  plan=$(resolve_plan "$root" "$@")
  tool=$(merge_danger_tool "$root") || gate=$?
  case $gate in
    1)
      echo "$PROG: no bin/merge-danger in this repo; nothing to cross-check" >&2
      return 0
      ;;
    2 | 3)
      echo "$PROG: $(merge_danger_refusal "$root" "$gate"); no cross-check" >&2
      return 0
      ;;
  esac

  # --check says whether the stored verdict still describes this content.
  # A stale or missing one (exit 1) is set aside for a fresh floor, which
  # carries no one's judgement.
  if msg=$(cd "$root" && "$tool" --check 2>&1); then rc=0; else rc=$?; fi
  case $rc in
    0)
      gitdir=$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || gitdir=""
      [[ -n $gitdir ]] && verdict=$(cat "$gitdir/merge-danger.json" 2>/dev/null) || true
      source=verdict
      status=$msg
      ;;
    1)
      err=$(mktemp)
      if ! verdict=$(cd "$root" && "$tool" --floor --stdout --committed 2>"$err"); then
        echo "$PROG: bin/merge-danger --floor failed: $(sed 's/^merge-danger: //' "$err" | head -n 1); no cross-check" >&2
        rm -f "$err"
        return 0
      fi
      rm -f "$err"
      source=floor
      status=$(printf '%s\n' "$msg" | head -n 1 | sed 's/^merge-danger: //; s/;.*//')
      ;;
    *)
      echo "$PROG: bin/merge-danger --check failed (exit $rc): $(printf '%s\n' "$msg" | head -n 1 | sed 's/^merge-danger: //'); no cross-check" >&2
      return 0
      ;;
  esac

  if ! printf '%s' "$verdict" | jq -e 'type == "object" and (.door | type) == "string" and (.depth | type) == "string"' >/dev/null 2>&1; then
    echo "$PROG: bin/merge-danger gave no readable verdict; no cross-check" >&2
    return 0
  fi

  local out
  if ! out=$(printf '%s' "$verdict" | jq --slurpfile plan "$plan" --arg source "$source" --arg status "$status" "$DANGER_JQ" 2>/dev/null); then
    echo "$PROG: could not compare the plan with the verdict; no cross-check" >&2
    return 0
  fi
  printf '%s\n' "$out"

  local n
  n=$(printf '%s' "$out" | jq '.disagreements | length')
  if [[ $(printf '%s' "$out" | jq -r '.review.door // empty') == "" ]]; then
    echo "$PROG: no group has a door call, so the door was not compared" >&2
  fi
  if [[ $n == 0 ]]; then
    echo "$PROG: the review agrees with the verdict; add this object as the plan's \"mergeDanger\" and write the plan again" >&2
  else
    echo "$PROG: $n disagreement(s); write each \"reason\", add this object as the plan's \"mergeDanger\", and write the plan again" >&2
  fi
}

cmd_report_dir() {
  local root plan dir slug
  root=$(repo_root)
  plan=$(resolve_plan "$root" "$@")
  dir=$(report_dir_for "$plan")

  if has_flag --init "$@"; then
    command -v jq >/dev/null 2>&1 || die "jq is required to scaffold a report directory"
    mkdir -p "$dir"
    if [[ ! -f "$dir/meta.json" ]]; then
      cat >"$dir/meta.json" <<'META'
{
  "title": "",
  "subtitle": "",
  "docs": []
}
META
    fi
    # The page's front matter, in the order it renders: the overview for
    # whoever decides whether the branch matters, the TL;DR for whoever
    # reviews it (the review record's settled items follow it), the decisions
    # and drift for whoever asked for the change, and the glossary for all.
    [[ -f "$dir/_overview.md" ]] || : >"$dir/_overview.md"
    [[ -f "$dir/_tldr.md" ]] || : >"$dir/_tldr.md"
    [[ -f "$dir/_decisions.md" ]] || : >"$dir/_decisions.md"
    [[ -f "$dir/_glossary.md" ]] || : >"$dir/_glossary.md"
    while IFS=$'\t' read -r slug _ _ _ _; do
      [[ -n $slug ]] || continue
      # One file per part of a group section, in the order they render: the
      # orientation, the concrete instance, then the reasoning bullets.
      [[ -f "$dir/$slug.why.md" ]] || : >"$dir/$slug.why.md"
      [[ -f "$dir/$slug.example.md" ]] || : >"$dir/$slug.example.md"
      [[ -f "$dir/$slug.md" ]] || : >"$dir/$slug.md"
    done < <(jq -r "$GROUPS_JQ" "$plan")
    echo "$PROG: scaffolded $dir" >&2
  fi

  printf '%s\n' "$dir"
}

cmd_render() {
  local root plan dir assets out outdir gh tmp
  root=$(repo_root)
  command -v jq >/dev/null 2>&1 || die "jq is required to render the report"

  plan=$(resolve_plan "$root" "$@")
  dir=$(report_dir_for "$plan")
  assets=$(assets_dir)
  out=$(html_path_for "$plan")

  local args=("$@") i
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == "-o" ]]; then
      out="${args[i + 1]:-}"
      [[ -n $out ]] || die "-o requires a path argument"
    fi
  done

  [[ -d $dir ]] ||
    die "no report directory at $dir -- run '$PROG report-dir --init' and write the body files first"
  [[ -f "$dir/meta.json" ]] || die "no meta.json in $dir"

  gh=$(github_slug)
  outdir=$(dirname "$out")
  mkdir -p "$outdir"

  # Pass 1: group metadata, and the slug -> title map the doc back-links need.
  local -a g_slug=() g_tier=() g_coll=() g_door=() g_title=() g_blast_scope=() g_blast_note=() g_summary=()
  local slug tier coll door bt bscope bnote bs
  while IFS=$'\t' read -r slug tier coll door bt bscope bnote bs; do
    [[ -n $slug ]] || continue
    g_slug+=("$slug")
    g_tier+=("$tier")
    g_coll+=("$coll")
    g_door+=("$door")
    g_title+=("$(b64d "$bt")")
    g_blast_scope+=("$([[ $bscope != - ]] && b64d "$bscope" || printf '')")
    g_blast_note+=("$([[ $bnote != - ]] && b64d "$bnote" || printf '')")
    g_summary+=("$(b64d "$bs")")
  done < <(jq -r "$GROUPS_JQ" "$plan")

  [[ ${#g_slug[@]} -gt 0 ]] || die "the plan has no groups to render"

  # Docs declared in meta.json. Fields are joined on "|" rather than @tsv'd:
  # base64 never contains a pipe, and `read` with IFS=$'\t' collapses runs of
  # tabs, so an empty middle field (a doc with a url and no path) would silently
  # shift every field after it.
  local -a d_slug=() d_id=() d_path=() d_url=() d_cited=()
  local bid bpath burl bcited did dpath durl
  while IFS='|' read -r bid bpath burl bcited; do
    [[ -n $bid ]] || continue
    did=$(b64d "$bid")
    dpath=$([[ -n $bpath ]] && b64d "$bpath" || printf '')
    durl=$([[ -n $burl ]] && b64d "$burl" || printf '')

    [[ -n $dpath && -n $durl ]] &&
      die "doc '$did' in meta.json has both \"path\" and \"url\" -- a doc is either read from disk or linked out, not both"
    [[ -z $dpath && -z $durl ]] &&
      die "doc '$did' in meta.json has neither \"path\" nor \"url\""
    # A nav entry is a live link; only ever point it off-machine over http(s).
    [[ -n $durl && $durl != http://* && $durl != https://* ]] &&
      die "doc '$did' has a non-http(s) url: $durl"

    d_id+=("$did")
    d_path+=("$dpath")
    d_url+=("$durl")
    d_cited+=("$([[ -n $bcited ]] && b64d "$bcited" || printf '')")
    d_slug+=("doc-$(slugify "$did")")
  done < <(jq -r '
    .docs[]?
    | [ (.id | @base64), ((.path // "") | @base64),
        ((.url // "") | @base64), ((.citedBy // "") | @base64) ]
    | join("|")
  ' "$dir/meta.json")

  local title subtitle
  title=$(jq -r '.title // ""' "$dir/meta.json")
  subtitle=$(jq -r '.subtitle // ""' "$dir/meta.json")
  [[ -n $title ]] || title="Review"

  # The merge-danger cross-check and the review record, both keyed by the
  # content digest bin/merge-danger computes. Each is read only if present,
  # and neither can withhold the page: a verdict read for other content is
  # labelled as such, and a record for other content is left out.
  local md_html="" held_html="" settled_html="" md_digest md_source md_stale=0 cur gitdir record rec_digest
  local md_tool md_gate=0 md_why
  md_tool=$(merge_danger_tool "$root") || md_gate=$?
  case $md_gate in
    1) md_why="the repo has no bin/merge-danger" ;;
    2 | 3) md_why=$(merge_danger_refusal "$root" "$md_gate") ;;
  esac
  if jq -e '.mergeDanger | type == "object"' "$plan" >/dev/null 2>&1; then
    md_digest=$(jq -r '.mergeDanger.digest // empty | strings' "$plan" 2>/dev/null) || md_digest=""
    md_source=$(jq -r '.mergeDanger.source // empty | strings' "$plan" 2>/dev/null) || md_source=""
    if [[ -n $md_digest && $md_gate != 0 ]]; then
      echo "$PROG: cannot tell whether the plan's mergeDanger describes this content ($md_why)" >&2
    elif [[ -n $md_digest ]]; then
      # A fresh floor was read for HEAD tree; a stored verdict for the working tree.
      if [[ $md_source == floor ]]; then
        cur=$(merge_danger_digest "$root" "$md_tool" --committed)
      else
        cur=$(merge_danger_digest "$root" "$md_tool")
      fi
      [[ -n $cur && $cur != "$md_digest" ]] && md_stale=1
    fi
    md_html=$(jq -r --arg stale "$md_stale" "$DANGER_HTML_JQ" "$plan" 2>/dev/null) || {
      md_html=""
      echo "$PROG: could not render the plan's mergeDanger; left it out" >&2
    }
  fi
  gitdir=$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || gitdir=""
  record="$gitdir/review-record.json"
  # The TL;DR says whether a review record covers this content. The same
  # check that shows or drops the record decides it, so the line stays true on
  # every render, the review loop's included, and it needs no agent prose. A
  # repo with no bin/merge-danger gets no line, unless a leftover record sits
  # in its git dir: the page cannot date that one, and says so.
  local gate_line="" gate_owed=0
  local gate_unknown="This page cannot tell whether a review record covers this content."
  # With no record file at all, no record covers this content, whether or
  # not bin/merge-danger may run.
  case $md_gate in
    0 | 2 | 3) gate_line="No review record covers this content yet." gate_owed=1 ;;
  esac
  if [[ -n $gitdir && -f $record ]]; then
    cur=""
    [[ $md_gate == 0 ]] && cur=$(merge_danger_digest "$root" "$md_tool")
    rec_digest=$(jq -r '.digest // empty | strings' "$record" 2>/dev/null) || rec_digest=""
    if [[ $md_gate != 0 ]]; then
      echo "$PROG: cannot tell which content $record describes ($md_why); left it out" >&2
      gate_line=$gate_unknown gate_owed=0
    elif [[ -z $cur ]]; then
      echo "$PROG: cannot tell which content $record describes (bin/merge-danger --digest gave nothing); left it out" >&2
      gate_line=$gate_unknown gate_owed=0
    elif [[ -z $rec_digest ]] && ! jq empty "$record" 2>/dev/null; then
      echo "$PROG: could not read $record; left it out" >&2
      gate_line=$gate_unknown gate_owed=0
    elif [[ -z $rec_digest ]]; then
      echo "$PROG: $record names no content digest; left it out" >&2
      gate_line=$gate_unknown gate_owed=0
    elif [[ $rec_digest != "$cur" ]]; then
      echo "$PROG: $record describes other content; left it out" >&2
      gate_line="The review record describes other content, so none covers this content yet."
    else
      if ! held_html=$(jq -r "$RECORD_HELD_JQ" "$record" 2>/dev/null) ||
        ! settled_html=$(jq -r "$RECORD_SETTLED_JQ" "$record" 2>/dev/null); then
        held_html="" settled_html=""
        echo "$PROG: could not read $record; left it out" >&2
        gate_line=$gate_unknown gate_owed=0
      elif [[ -n $held_html ]]; then
        gate_line="The review gate read this content. What it held for you follows." gate_owed=0
      else
        gate_line="The review gate read this content. It held nothing for you." gate_owed=0
      fi
    fi
  fi
  [[ $gate_owed == 1 ]] && echo "$PROG: no review record covers this content yet" >&2

  tmp=$(mktemp "$outdir/.report.XXXXXX")

  {
    printf '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
    printf '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
    printf '<title>%s</title>\n<style>\n' "$(esc "$title")"
    cat "$assets/report.css"
    printf '</style>\n</head>\n<body>\n'

    # ── nav ──
    printf '<nav class="top"><div class="nav-inner">\n'
    printf '  <a href="#" data-nav="review">Review</a>\n'
    if [[ ${#d_slug[@]} -gt 0 ]]; then
      printf '  <span class="nav-sep">|</span>\n'
      for ((i = 0; i < ${#d_slug[@]}; i++)); do
        # A url doc has no pane, so it carries no data-nav: routing must never
        # try to activate a link that leaves the page.
        if [[ -n ${d_url[i]} ]]; then
          printf '  <a class="nav-ext" href="%s" target="_blank" rel="noopener noreferrer">%s<span class="ext-mark">&#8599;</span></a>\n' \
            "$(esc "${d_url[i]}")" "$(esc "${d_id[i]}")"
        else
          printf '  <a href="#%s" data-nav="%s">%s</a>\n' \
            "${d_slug[i]}" "${d_slug[i]}" "$(esc "${d_id[i]}")"
        fi
      done
    fi
    printf '</div></nav>\n<main>\n'

    # ── review pane ──
    printf '<div class="pane" id="pane-review"><div class="wrap">\n'
    printf '  <h1>%s</h1>\n' "$(esc "$title")"
    [[ -n $subtitle ]] && printf '  <p class="subtitle">%s</p>\n' "$(esc "$subtitle")"

    # Always printed: the decisions slot says something even when nothing else
    # in the front matter does.
    {
      printf '  <div class="front">\n'
      if [[ -s "$dir/_overview.md" ]]; then
        printf '  <div class="overview"><h3>Overview</h3><div class="md">'
        printf '<script type="text/markdown">%s</script>' "$(b64e "$dir/_overview.md")"
        printf '</div></div>\n'
      fi
      # The TL;DR leads with any disagreement with the verdict, and ends with
      # whether a review record covers this content and what it left for a
      # person to decide.
      if [[ -s "$dir/_tldr.md" || -n $md_html || -n $gate_line || -n $held_html ]]; then
        printf '  <div class="tldr"><h3>TL;DR</h3>'
        [[ -n $md_html ]] && printf '%s' "$md_html"
        if [[ -s "$dir/_tldr.md" ]]; then
          printf '<div class="md"><script type="text/markdown">%s</script></div>' "$(b64e "$dir/_tldr.md")"
        fi
        [[ -n $gate_line ]] && printf '<p class="gate-status">%s</p>' "$(esc "$gate_line")"
        [[ -n $held_html ]] && printf '%s' "$held_html"
        printf '</div>\n'
      fi
      [[ -n $settled_html ]] && printf '  %s\n' "$settled_html"
      # Only the session where the change was asked for knows what was asked,
      # so an empty file is the honest answer from any other session. Say so,
      # rather than leave the reader to wonder whether the block was forgotten.
      if [[ -s "$dir/_decisions.md" ]]; then
        printf '  <div class="decisions"><h3>Decisions &amp; drift</h3><div class="md">'
        printf '<script type="text/markdown">%s</script>' "$(b64e "$dir/_decisions.md")"
        printf '</div></div>\n'
      else
        printf '  <p class="decisions-none">Decisions and drift: not written. Only the session where the change was asked for can tell what drifted from it.</p>\n'
      fi
      # Closed by default: a reader looks a term up, nobody reads the list.
      if [[ -s "$dir/_glossary.md" ]]; then
        local nterms label="Glossary"
        nterms=$(grep -c '^[[:space:]]*[-*+][[:space:]]' "$dir/_glossary.md" || true)
        if [[ $nterms == 1 ]]; then
          label="Glossary (1 term)"
        elif [[ $nterms -gt 1 ]]; then
          label="Glossary ($nterms terms)"
        fi
        printf '  <details class="glossary"><summary>%s</summary><div class="md">' "$label"
        printf '<script type="text/markdown">%s</script>' "$(b64e "$dir/_glossary.md")"
        printf '</div></details>\n'
      fi
      printf '  </div>\n'
    }
    [[ -s "$dir/_overview.md" ]] ||
      echo "$PROG: no overview (expected $dir/_overview.md)" >&2

    printf '  <nav class="toc"><h3>Sections</h3><ol>\n'
    for ((i = 0; i < ${#g_slug[@]}; i++)); do
      printf '    <li><a href="#group-%s">%s</a>' "${g_slug[i]}" "$(esc "${g_title[i]}")"
      [[ -n ${g_summary[i]} ]] &&
        printf '<span class="toc-summary">%s</span>' "$(esc "${g_summary[i]}")"
      printf '</li>\n'
    done
    printf '  </ol></nav>\n'

    for ((i = 0; i < ${#g_slug[@]}; i++)); do
      local body="$dir/${g_slug[i]}.md" notes="$dir/${g_slug[i]}.notes.md"
      local why="$dir/${g_slug[i]}.why.md" example="$dir/${g_slug[i]}.example.md"
      local label="${g_tier[i]}"
      case "$label" in
        critical) label="Critical" ;;
        review) label="Review" ;;
        *) label="Skim" ;;
      esac

      printf '  <section class="group" id="group-%s">\n' "${g_slug[i]}"
      [[ ${g_coll[i]} == 1 ]] && printf '    <details>\n    <summary>\n'
      # The door is a second badge, never a second sort key: importance alone
      # placed this group, and a group with no door call gets no badge at all.
      local door_badge=""
      case "${g_door[i]}" in
        one-way) door_badge=' <span class="badge door one-way">One-way</span>' ;;
        two-way) door_badge=' <span class="badge door two-way">Two-way</span>' ;;
      esac
      printf '    <h2><span class="badge %s">%s</span>%s %s</h2>\n' \
        "${g_tier[i]}" "$label" "$door_badge" "$(esc "${g_title[i]}")"
      [[ ${g_coll[i]} == 1 ]] && printf '    </summary>\n'
      [[ -n ${g_summary[i]} ]] &&
        printf '    <p class="group-summary">%s</p>\n' "$(esc "${g_summary[i]}")"
      # Same "scope — note" shape bin/merge-danger writes into a Vendis PR body.
      [[ -n ${g_blast_scope[i]} ]] &&
        printf '    <p class="blast-radius">Blast radius: <strong>%s</strong> &mdash; %s</p>\n' \
          "$(esc "${g_blast_scope[i]}")" "$(esc "${g_blast_note[i]}")"

      # Orientation before reasoning: what the topic is and what it fixes, then
      # one concrete instance of it. A group without a why still renders -- a
      # report directory written before these files existed must not break --
      # but it is a gap in the writeup, so say so on stderr.
      if [[ -s $why ]]; then
        printf '    <div class="why"><h3>Why</h3><div class="md">'
        printf '<script type="text/markdown">%s</script>' "$(b64e "$why")"
        printf '</div></div>\n'
      else
        echo "$PROG: no why for group '${g_title[i]}' (expected $why)" >&2
      fi

      # The example is optional by design: a Skim group would have to invent one.
      if [[ -s $example ]]; then
        printf '    <div class="example"><h3>Example</h3><div class="md">'
        printf '<script type="text/markdown">%s</script>' "$(b64e "$example")"
        printf '</div></div>\n'
      fi

      if [[ -s $body ]]; then
        printf '    <div class="md"><script type="text/markdown">%s</script></div>\n' "$(b64e "$body")"
      else
        printf '    <p class="no-writeup">No writeup was written for this group.</p>\n'
        echo "$PROG: no body for group '${g_title[i]}' (expected $body)" >&2
      fi

      if [[ -s $notes ]]; then
        printf '    <div class="notes"><h3>Review notes</h3><div class="md">'
        printf '<script type="text/markdown">%s</script>' "$(b64e "$notes")"
        printf '</div></div>\n'
      fi

      [[ ${g_coll[i]} == 1 ]] && printf '    </details>\n'
      printf '  </section>\n'
    done

    printf '  <footer class="gen">Generated %s</footer>\n' "$(date '+%Y-%m-%d %H:%M')"
    # Attribution. The lockups are inlined rather than linked because this page
    # is a review of unmerged code and must never reach the network to render.
    # Guarded: a missing asset drops the footer, it never aborts a render.
    if [[ -f "$assets/vendis-logo.svg" && -f "$assets/vendis-logo-dark.svg" ]]; then
      printf '  <footer class="brand"><a href="https://vendis.ai" target="_blank" rel="noopener noreferrer" aria-label="Vendis">'
      printf '<span class="logo-light">'
      cat "$assets/vendis-logo.svg"
      printf '</span><span class="logo-dark">'
      cat "$assets/vendis-logo-dark.svg"
      printf '</span></a></footer>\n'
    fi
    printf '</div></div>\n'

    # ── doc panes ──
    local resolved fmt
    for ((i = 0; i < ${#d_slug[@]}; i++)); do
      [[ -n ${d_url[i]} ]] && continue # url docs are a nav link, not a pane

      resolved=$(resolve_doc_path "$root" "${d_path[i]}")
      fmt=$(doc_format "${d_path[i]}")

      printf '<div class="pane" data-doc="%s" hidden><div class="wrap"><article class="doc">\n' "${d_slug[i]}"
      printf '  <h1>%s</h1>\n' "$(esc "${d_id[i]}")"
      printf '  <p class="doc-src">%s</p>\n' "$(esc "${d_path[i]}")"
      if [[ -f $resolved ]]; then
        printf '  <div class="md" data-format="%s"><script type="text/markdown">%s</script></div>\n' \
          "$fmt" "$(b64e "$resolved")"
      else
        printf '  <div class="missing">Not found on disk: <code>%s</code></div>\n' \
          "$(esc "$resolved")"
        echo "$PROG: referenced doc not found: $resolved" >&2
      fi
      # Returning is scroll memory's job -- it lands the reader on the bullet
      # they left, not on the top of the group containing it. citedBy stays the
      # label so the link still says where "back" goes.
      if [[ -n ${d_cited[i]} ]]; then
        local backtitle="${d_cited[i]}" j
        for ((j = 0; j < ${#g_slug[@]}; j++)); do
          [[ ${g_slug[j]} == "${d_cited[i]}" ]] && backtitle="${g_title[j]}"
        done
        printf '  <a class="back-link" href="#">&larr; back to %s</a>\n' "$(esc "$backtitle")"
      else
        printf '  <a class="back-link" href="#">&larr; back to review</a>\n'
      fi
      printf '</article></div></div>\n'
    done

    printf '</main>\n'
    printf '<script>window.__REPORT__ = %s;</script>\n' \
      "$(jq -nc --arg r "$gh" '{repo: (if $r == "" then null else $r end)}')"
    printf '<script src="marked.min.js"></script>\n'
    printf '<script src="mermaid.min.js"></script>\n'
    printf '<script>\n'
    cat "$assets/report.js"
    printf '</script>\n</body>\n</html>\n'
  } >"$tmp"

  mv -f "$tmp" "$out"

  local a
  for a in marked.min.js mermaid.min.js; do
    [[ -f "$outdir/$a" ]] || cp "$assets/$a" "$outdir/$a"
  done

  manifest_record "$root"
  prose_warnings "$dir"
  echo "$PROG: wrote $out"
}

# ── readability check ────────────────────────────────────────────────────────
#
# Warnings only: a long sentence is a rewrite to make, never a reason to
# withhold the page. The sentence limit is ASD-STE100's for descriptive text;
# the glossary limits are the skill's own, with a little slack. Code fences,
# Mermaid blocks, headings and table rows are not prose, and an inline code
# span counts as one word however many spaces it holds. Both programs avoid
# GNU-only awk, because macOS runs this under BSD awk.

SENTENCE_MAX_WORDS=25
GLOSSARY_MAX_TERMS=12
GLOSSARY_MAX_WORDS=15

# An inline code span is one word: its inner spaces become \037 until the
# text is printed back, so the warning quotes the sentence as written.
CODEWORD_AWK='
function codeword(s,   out, seg) {
  out = ""
  while (match(s, /`[^`]*`/)) {
    seg = substr(s, RSTART, RLENGTH)
    gsub(/[ \t]/, "\037", seg)
    out = out substr(s, 1, RSTART - 1) seg
    s = substr(s, RSTART + RLENGTH)
  }
  return out s
}
function shown(s) { gsub("\037", " ", s); return s }
'

PROSE_AWK='
function flush(   n, parts, i, w, nw, j, cnt, head) {
  if (block == "") return
  n = split(block, parts, /[.!?]["*)]*[ \t]+/)
  for (i = 1; i <= n; i++) {
    nw = split(parts[i], w, /[ \t]+/)
    cnt = 0; head = ""
    for (j = 1; j <= nw; j++) {
      if (w[j] == "") continue
      cnt++
      if (cnt <= 8) head = head (head == "" ? "" : " ") w[j]
    }
    if (cnt > max) printf "%s: long sentence (%d words) in %s: \"%s ...\"\n", prog, cnt, name, shown(head)
  }
  block = ""
}
/^[ \t]*(```|~~~)/ { flush(); fence = !fence; next }
fence { next }
/<pre[ >]/ { flush(); pre = 1 }
pre { if ($0 ~ /<\/pre>/) pre = 0; next }
/^[ \t]*\|/ { flush(); next }
/^[ \t]*#/ { flush(); next }
/^[ \t]*$/ { flush(); next }
{
  line = $0
  gsub(/<span class="ref">[^<]*<\/span>/, "", line)
  gsub(/<[^>]*>/, " ", line)
  line = codeword(line)
  gsub(/\]\([^)]*\)/, "]", line)
  if (line ~ /^[ \t]*([-*+]|[0-9]+\.)[ \t]/) {
    flush()
    sub(/^[ \t]*([-*+]|[0-9]+\.)[ \t]+/, "", line)
  }
  block = block " " line
}
END { flush() }
'

GLOSSARY_AWK='
/^[ \t]*[-*+][ \t]/ {
  terms++
  line = $0
  sub(/^[ \t]*[-*+][ \t]+/, "", line)
  line = codeword(line)
  term = line; def = ""
  if (index(line, ":") > 0) {
    term = substr(line, 1, index(line, ":") - 1)
    def = substr(line, index(line, ":") + 1)
  }
  gsub(/\*/, "", term); gsub(/\*/, "", def)
  nw = split(def, w, /[ \t]+/); cnt = 0
  for (j = 1; j <= nw; j++) if (w[j] != "") cnt++
  if (cnt > max_words) printf "%s: long glossary entry (%d words) for \"%s\"\n", prog, cnt, shown(term)
}
END {
  if (terms > max_terms) printf "%s: glossary has %d terms; keep it to %d\n", prog, terms, max_terms
}
'

prose_warnings() {
  local dir="$1" f
  for f in "$dir"/*.md; do
    [[ -s $f ]] || continue
    if [[ $(basename "$f") == _glossary.md ]]; then
      awk -v prog="$PROG" -v max_terms="$GLOSSARY_MAX_TERMS" \
        -v max_words="$GLOSSARY_MAX_WORDS" "$CODEWORD_AWK$GLOSSARY_AWK" "$f" >&2
    else
      awk -v prog="$PROG" -v max="$SENTENCE_MAX_WORDS" -v name="$(basename "$f")" \
        "$CODEWORD_AWK$PROSE_AWK" "$f" >&2
    fi
  done
}

# ── review loop ──────────────────────────────────────────────────────────────
#
# `wait` is the agent's half of the loop. The review-plan extension writes
# <loop>/go.json when the reviewer presses "Send review to agent" or "Approve";
# this consumes it. The file carries the notes themselves, read from the Hunk
# process, so the loop keeps working after a reload has dropped the session
# from the daemon (modem-dev/hunk#1138). Polling a file once a second is cheap;
# each `wait` call is still one bounded call for the agent.

WAIT_GO=0
WAIT_APPROVED=10
WAIT_PENDING=2
WAIT_NOTHING=3
SENTINEL_EVERY=15

# Print a marker file and exit with the code its kind stands for.
emit_marker() {
  local file="$1" kind
  kind=$(jq -r '.kind' "$file")
  jq . "$file"
  [[ $kind == approve ]] && exit "$WAIT_APPROVED"
  exit "$WAIT_GO"
}

# True when a hand-off file answers an earlier plan than the one waited on.
# Once the plan carries an id, the ids decide, and a file without one comes
# from a Hunk window started before plan ids: it cannot show this plan's id,
# so it cannot answer this plan either. Only a plan from before plan ids
# falls back to file times -- a file older than the plan belongs to an
# earlier review, the rule window_closed applies to window.json.
for_earlier_plan() {
  local file="$1" plan="$2" plan_id="$3" file_id
  [[ -n $plan ]] || return 1
  file_id=$(plan_id_of "$file")
  if [[ -n $plan_id ]]; then
    [[ $file_id != "$plan_id" ]]
    return
  fi
  [[ $plan -nt $file ]]
}

# Take go.json if it is there. The rename is the claim: with two waiters on one
# repo only one rename succeeds, so a hand-off is delivered exactly once. A
# hand-off for an earlier plan is set aside, never delivered: an approval of
# the old content must not approve this review. Its notes stay in stale.json.
take_marker() {
  local loop="$1" plan="$2" plan_id="$3" taken
  taken="$loop/taken.$$.json"
  mv "$loop/go.json" "$taken" 2>/dev/null || return 1
  if ! jq -e '.version == 1 and (.kind == "go" or .kind == "approve")' "$taken" >/dev/null 2>&1; then
    mv -f "$taken" "$loop/invalid.json"
    die "ignored an unreadable hand-off; it is kept at $loop/invalid.json"
  fi
  if for_earlier_plan "$taken" "$plan" "$plan_id"; then
    mv -f "$taken" "$loop/stale.json"
    if [[ -n $(plan_id_of "$loop/stale.json") ]]; then
      echo "$PROG: set aside a hand-off from a Hunk window showing an earlier plan; press r in Hunk and send again (kept at $loop/stale.json)" >&2
    else
      echo "$PROG: set aside a hand-off from a Hunk window started before plan ids; quit and reopen Hunk, then send again (kept at $loop/stale.json)" >&2
    fi
    return 1
  fi
  mv -f "$taken" "$loop/last.json"
  emit_marker "$loop/last.json"
}

# The fallback when the extension did not load: a note typed in Hunk that reads
# GO, "GO: <instruction>" (the colon is optional) or APPROVE. Uppercase, as its
# own word, so "go through this again" or "GOT it" in an ordinary note never
# fires. Read through the session daemon, so this path
# does not survive #1138 the way the extension's does. Each sentinel fires
# once: its id is recorded, and it is removed from the session when possible.
# Only a note written after the plan counts; one typed into a window that
# still shows an earlier review answers that review. A note whose time cannot
# be read counts, as before.
#
# The daemon does not say which window a note came from, so nothing ties a
# typed note to the plan its window shows. Once an extension that records
# plan ids has opened the repo (window.json carries one), S and A are the
# hand-off and typed notes are not read at all. What remains is the case with
# no extension: a GO typed into a window opened before the new plan counts.
take_sentinel() {
  local root="$1" loop="$2" plan="$3" plan_id="$4" list seen head marker id since=0
  [[ -z $(plan_id_of "$loop/window.json") ]] || return 1
  command -v hunk >/dev/null 2>&1 || return 1
  list=$(hunk session comment list --repo "$root" --type user --json 2>/dev/null) || return 1
  seen='[]'
  [[ -f "$loop/sentinels" ]] && seen=$(jq -R -s 'split("\n") | map(select(length > 0))' "$loop/sentinels")
  head=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
  if [[ -n $plan ]]; then since=$(mtime_of "$plan") || since=0; fi

  marker=$(printf '%s' "$list" | jq -e \
    --arg root "$root" --arg head "$head" --argjson seen "$seen" --argjson since "${since:-0}" \
    --arg planId "$plan_id" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    def text: (.body // .summary // "");
    def written: (try (.createdAt | sub("\\.[0-9]+"; "") | fromdateiso8601) catch null);
    [.comments[]?] as $all
    | [ $all[] | select(.noteId as $id | $seen | any(. == $id) | not)
               | select(written as $t | $t == null or $t >= $since)
               | select(text | test("\\A\\s*(GO|APPROVE)(\\s*:|\\s|\\z)")) ] | first
    | select(. != null) as $s
    | ($s | text | capture("\\A\\s*(?<kw>GO|APPROVE)(\\s*:\\s*|\\s+|\\z)(?<rest>.*)\\z"; "p")) as $m
    | ($m.rest | sub("\\s+\\z"; "")) as $rest
    | {
        version: 1,
        kind: (if $m.kw == "GO" then "go" else "approve" end),
        mode: (if $m.kw == "GO" then "fix-clear" else null end),
        instruction: (if $m.kw == "GO" and ($rest | length) > 0 then $rest else null end),
        repoRoot: $root,
        planId: (if $planId == "" then null else $planId end),
        head: (if $head == "" then null else $head end),
        createdAt: $now,
        sentinel: $s.noteId,
        notes: [ $all[] | select(.noteId != $s.noteId) | {
          id: .noteId,
          source: (.source // "user"),
          file: (.filePath // null),
          side: (if .newRange then "new" elif .oldRange then "old" else null end),
          line: ((.newRange // .oldRange // [null])[0]),
          summary: text,
          new: true
        } + (if .newRange then {newRange} else {} end)
          + (if .oldRange then {oldRange} else {} end)
          + (if .author then {author} else {} end)
          + (if .createdAt then {createdAt} else {} end) ]
      }' 2>/dev/null) || return 1

  id=$(printf '%s' "$marker" | jq -r '.sentinel')
  mkdir -p "$loop"
  printf '%s\n' "$id" >>"$loop/sentinels"
  hunk session comment rm --repo "$root" "$id" >/dev/null 2>&1 || true
  printf '%s\n' "$marker" >"$loop/last.json"
  emit_marker "$loop/last.json"
}

# True when Hunk had this repo open for the current plan and has quit since,
# cleanly (closedAt) or not (the process is gone). A window that showed an
# earlier plan says nothing about this one, even when it quits after this plan
# was written; for_earlier_plan decides, by plan id or by file time.
window_closed() {
  local window="$1" plan="$2" plan_id="$3" closed pid
  [[ -f $window ]] || return 1
  for_earlier_plan "$window" "$plan" "$plan_id" && return 1
  closed=$(jq -r '.closedAt // empty' "$window" 2>/dev/null) || return 1
  [[ -n $closed ]] && return 0
  pid=$(jq -r '.pid // empty' "$window" 2>/dev/null) || return 1
  [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null
}

cmd_wait() {
  local root loop plan plan_id timeout=480 args=("$@") i start next_sentinel=0
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == "--timeout" ]]; then
      timeout="${args[i + 1]:-}"
      [[ $timeout =~ ^[0-9]+$ ]] || die "--timeout requires a number of seconds"
    fi
  done
  command -v jq >/dev/null 2>&1 || die "jq is required to read the hand-off"

  root=$(repo_root)
  loop=$(loop_dir_for "$root")
  plan=$(resolve_plan "$root" 2>/dev/null) || plan=""
  plan_id=$(plan_id_of "$plan")

  if [[ -z $plan && ! -f "$loop/window.json" && ! -f "$loop/go.json" ]]; then
    echo "$PROG: nothing to wait on: no review plan for $root, and Hunk has not opened it" >&2
    exit "$WAIT_NOTHING"
  fi

  start=$SECONDS
  while :; do
    # Both take_* functions exit the script when they deliver something, and
    # return 1 when there was nothing to take -- which `set -e` must not see.
    if [[ -f "$loop/go.json" ]]; then take_marker "$loop" "$plan" "$plan_id" || true; fi
    if ((SECONDS >= next_sentinel)); then
      take_sentinel "$root" "$loop" "$plan" "$plan_id" || true
      next_sentinel=$((SECONDS + SENTINEL_EVERY))
    fi
    if window_closed "$loop/window.json" "$plan" "$plan_id"; then
      echo "$PROG: nothing to wait on: Hunk was closed without sending the review back" >&2
      exit "$WAIT_NOTHING"
    fi
    if ((SECONDS - start >= timeout)); then
      echo "$PROG: still waiting after ${timeout}s; run 'hunk-plan wait' again" >&2
      exit "$WAIT_PENDING"
    fi
    sleep 1
  done
}

# ── garbage collection ───────────────────────────────────────────────────────

# Remove every artifact belonging to one digest.
gc_remove_family() {
  local base="$1" dry="$2" target
  for target in "$base.json" "$base.html" "$base.viewed.json" "$base.sidecar.json" "$base.notes.jsonl"; do
    [[ -e $target ]] || continue
    if [[ $dry == 1 ]]; then echo "  would remove $target"; else rm -f "$target"; fi
  done
  for target in "$base.report" "$base.loop"; do
    [[ -d $target ]] || continue
    if [[ $dry == 1 ]]; then echo "  would remove $target/"; else rm -rf "$target"; fi
  done
}

cmd_gc() {
  local sdir mf dry=0 days=30 args=("$@") i
  sdir="$(state_dir)/hunk/review-plan"
  mf=$(manifest_path)

  has_flag --dry-run "$@" && dry=1
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == "--older-than" ]]; then
      days="${args[i + 1]:-}"
      [[ $days =~ ^[0-9]+$ ]] || die "--older-than requires a number of days"
    fi
  done

  [[ -d $sdir ]] || {
    echo "$PROG: nothing to collect ($sdir does not exist)"
    return 0
  }

  local -a doomed=() reasons=()
  local f base digest root

  # Pass 1: any artifact whose digest has no plan is dead by definition.
  for f in "$sdir"/*.viewed.json "$sdir"/*.html "$sdir"/*.sidecar.json "$sdir"/*.report "$sdir"/*.loop; do
    [[ -e $f ]] || continue
    base="${f%.viewed.json}"
    base="${base%.sidecar.json}"
    base="${base%.html}"
    base="${base%.report}"
    base="${base%.loop}"
    [[ -f "$base.json" ]] && continue
    doomed+=("$base")
    reasons+=("orphan: no plan file")
  done

  # A notes journal is the exception: Hunk journals notes with no plan at all,
  # and those are the reviewer's work. Without a plan it goes only once it is
  # as old as a plan would have to be.
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    base="${f%.notes.jsonl}"
    [[ -f "$base.json" ]] && continue
    doomed+=("$base")
    reasons+=("orphan notes journal older than $days days")
  done < <(find "$sdir" -maxdepth 1 -name '*.notes.jsonl' -mtime "+$days" 2>/dev/null)

  # Pass 2: the manifest says which repo a digest came from, so a deleted repo
  # becomes collectable rather than an unreadable hash.
  if [[ -f $mf ]] && command -v jq >/dev/null 2>&1; then
    while IFS=$'\t' read -r digest root; do
      [[ -n $digest ]] || continue
      [[ -d "$root/.git" || -f "$root/.git" ]] && continue
      base="$sdir/$digest"
      [[ -f "$base.json" ]] || continue
      doomed+=("$base")
      reasons+=("repo is gone: $root")
    done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' "$mf" 2>/dev/null)
  fi

  # Pass 3: age. The plan is regenerated every run, not a durable note.
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    base="${f%.json}"
    doomed+=("$base")
    reasons+=("older than $days days")
  done < <(find "$sdir" -maxdepth 1 -name '*.json' ! -name 'repos.json' ! -name '*.viewed.json' ! -name '*.sidecar.json' -mtime "+$days" 2>/dev/null)

  # A digest can be caught by more than one pass -- an orphaned .html and an
  # orphaned .viewed.json share a base, and a gone repo can also be old. Keep
  # the first reason so the listing reads as one line per digest.
  #
  # A newline-delimited list rather than an associative array: macOS ships bash
  # 3.2, which has no `local -A`, and this whole command aborted there.
  local seen=$'\n'
  local -a uniq_doomed=() uniq_reasons=()
  for ((i = 0; i < ${#doomed[@]}; i++)); do
    [[ $seen == *$'\n'"${doomed[i]}"$'\n'* ]] && continue
    seen="${seen}${doomed[i]}"$'\n'
    uniq_doomed+=("${doomed[i]}")
    uniq_reasons+=("${reasons[i]}")
  done
  doomed=("${uniq_doomed[@]:-}")
  reasons=("${uniq_reasons[@]:-}")
  [[ -n ${doomed[0]:-} ]] || doomed=()

  if [[ ${#doomed[@]} -eq 0 ]]; then
    echo "$PROG: nothing to collect in $sdir"
    return 0
  fi

  echo "$PROG: collectable review-plan state in $sdir"
  for ((i = 0; i < ${#doomed[@]}; i++)); do
    printf '  %s  (%s)\n' "$(basename "${doomed[i]}")" "${reasons[i]}"
  done

  if [[ $dry == 1 ]]; then
    echo "$PROG: --dry-run, nothing removed"
    return 0
  fi
  if ! has_flag --yes "$@"; then
    local reply
    read -r -p "Remove these? [y/N] " reply || reply="n"
    [[ $reply =~ ^[Yy]$ ]] || die "aborted, nothing removed"
  fi

  for ((i = 0; i < ${#doomed[@]}; i++)); do
    gc_remove_family "${doomed[i]}" 0
    if [[ -f $mf ]] && command -v jq >/dev/null 2>&1; then
      local tmp
      tmp=$(mktemp "$sdir/.repos.XXXXXX")
      if jq --arg d "$(basename "${doomed[i]}")" 'del(.[$d])' "$mf" >"$tmp" 2>/dev/null; then
        mv -f "$tmp" "$mf"
      else
        rm -f "$tmp"
      fi
    fi
  done
  echo "$PROG: removed ${#doomed[@]} plan famil$([[ ${#doomed[@]} -eq 1 ]] && echo y || echo ies)"

  # Shared assets are only dead once the last report that could load them is.
  if ! compgen -G "$sdir/*.html" >/dev/null; then
    local a
    for a in marked.min.js mermaid.min.js; do
      [[ -f "$sdir/$a" ]] && rm -f "$sdir/$a" && echo "$PROG: removed $sdir/$a (no reports left)"
    done
  fi
}

main() {
  local sub="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$sub" in
    path) cmd_path "$@" ;;
    write) cmd_write "$@" ;;
    show) cmd_show "$@" ;;
    sidecar) cmd_sidecar "$@" ;;
    report-dir) cmd_report_dir "$@" ;;
    render) cmd_render "$@" ;;
    gc) cmd_gc "$@" ;;
    clear) cmd_clear "$@" ;;
    viewed) cmd_viewed "$@" ;;
    notes) cmd_notes "$@" ;;
    list) cmd_list "$@" ;;
    danger) cmd_danger "$@" ;;
    wait) cmd_wait "$@" ;;
    -h | --help) usage ;;
    "")
      usage >&2
      exit 1
      ;;
    *)
      die "unknown command '$sub' (see --help)"
      ;;
  esac
}

main "$@"
